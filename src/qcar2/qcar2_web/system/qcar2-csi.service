[Unit]
Description=QCar2 4 CSI cameras (surround view); started/stopped by the web node (eco mode: only while used)
# Needs the robot nodes; stops with them (MATLAB mode).
Requisite=qcar2-robot.service
After=qcar2-robot.service
PartOf=qcar2-robot.service

[Service]
User=nvidia
ExecStart=/usr/local/bin/qcar2-run start_web:=false start_hardware:=false start_lidar:=false start_odom:=false start_csi:=true start_realsense:=false
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
